# Optional. `govern` signs you in interactively (/login) and saves keys to
# ~/.config/governor/credentials. Values here (or in your shell) take precedence.

# AWS (bedrock / mantle providers), pick one:
# AWS_PROFILE=my-profile                     # SSO profile (run: aws sso login --profile my-profile)
# AWS_BEARER_TOKEN_BEDROCK=                   # Bedrock API key
# AWS_REGION=us-east-1

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Scripted `govern run` overrides
# GOVERNOR_PROVIDER=openai
# GOVERNOR_MODEL=sol
# GOVERNOR_ALLOW=bash,write_file,edit_file     # pre-approve tools (* for all)
